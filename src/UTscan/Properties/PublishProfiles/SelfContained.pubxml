<Project>
  <!--
    Self-contained 单文件发布配置（x86：原生硬件 DLL 均为 32 位）：
      dotnet publish src/UTscan -c Release -r win-x86 (self-contained 见下方属性)
    产物：src/UTscan/bin/Release/net8.0-windows/win-x86/publish/UTscan.exe
    整个文件夹可拷贝到任意 Win10/11 机器直接运行，无需安装 .NET。
    注意：目标机仍需安装 Spectrum 驱动（内核模式 spcm.sys 无法随包分发）。
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- 不裁剪以避免 WinForms 反射调用被剪掉 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>